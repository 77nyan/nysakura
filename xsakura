# ----------------------------------------------------------------- colors
def mix(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def shade(c, f):
    return tuple(max(0, min(255, int(v * f))) for v in c)


def ramp(base):
    """five shades of one color, light -> deep"""
    w, k = (255, 255, 255), (0, 0, 0)
    return [mix(base, w, .72), mix(base, w, .4), base, mix(base, k, .2), mix(base, k, .38)]


THEMES = {
    "sakura": [(255, 238, 242), (255, 216, 226), (255, 186, 201), (247, 156, 183), (226, 120, 155)],
    "green": [(198, 240, 150), (148, 214, 104), (100, 184, 84), (64, 148, 70), (42, 112, 58)],
    "pink": ramp((255, 105, 170)),
    "red": ramp((232, 48, 70)),
    "orange": ramp((255, 146, 48)),
    "yellow": ramp((255, 212, 66)),
    "gold": ramp((236, 180, 40)),
    "cyan": ramp((66, 212, 230)),
    "blue": ramp((80, 140, 255)),
    "purple": ramp((168, 98, 240)),
    "magenta": ramp((232, 66, 190)),
    "white": ramp((250, 250, 252)),
}
RAINBOW = ("red", "orange", "yellow", "green", "cyan", "blue", "purple", "magenta")
_a256 = {}


def ansi256(c):
    v = _a256.get(c)
    if v is None:
        r, g, b = c
        if abs(r - g) < 10 and abs(g - b) < 10:
            gray = (r + g + b) // 3
            v = 16 if gray < 8 else 231 if gray > 248 else 232 + round((gray - 8) / 247 * 23)
        else:
            v = 16 + 36 * round(r / 255 * 5) + 6 * round(g / 255 * 5) + round(b / 255 * 5)
        _a256[c] = v
    return v


# ------------------------------------------------------- terminal output
class Term:
    def __init__(self, truecolor):
        self.tc = truecolor

    def col(self, kind, c):
        if self.tc:
            return "%d;2;%d;%d;%d" % (kind, c[0], c[1], c[2])
        return "%d;5;%d" % (kind, ansi256(c))

    def run(self, t, b, lo, hi, st, out):
        """emit cells lo..hi of a pixel-row pair (half blocks: 2 pixels per cell)"""
        for x in range(lo, hi + 1):
            u, d = t[x], b[x]
            if u is None and d is None:
                ch, f, g = " ", None, None
            elif u is None:
                ch, f, g = "▄", d, None
            elif d is None:
                ch, f, g = "▀", u, None
            elif u == d:
                ch, f, g = "█", u, None
            else:
                ch, f, g = "▀", u, d
            codes = []
            if g is None:
                if st[1] is not None:
                    codes.append("49")
                    st[1] = None
            elif g != st[1]:
                codes.append(self.col(48, g))
                st[1] = g
            if ch != " " and f != st[0]:
                codes.append(self.col(38, f))
                st[0] = f
            if codes:
                out.append("\x1b[" + ";".join(codes) + "m")
            out.append(ch)

    def render(self, cv, prev, cols, rows):
        """only redraw the rows/cells that changed since the previous frame"""
        out, st = ["\x1b[0m"], [None, None]
        for r in range(rows):
            t, b = cv[2 * r], cv[2 * r + 1]
            if prev is None:
                lo, hi = 0, cols - 1
            else:
                pt, pb = prev[2 * r], prev[2 * r + 1]
                if t == pt and b == pb:
                    continue
                lo = next(x for x in range(cols) if t[x] != pt[x] or b[x] != pb[x])
                hi = next(x for x in range(cols - 1, -1, -1) if t[x] != pt[x] or b[x] != pb[x])
            out.append("\x1b[%d;%dH" % (r + 1, lo + 1))
            self.run(t, b, lo, hi, st, out)
        out.append("\x1b[0m")
        return "".join(out)

    def lines(self, cv, cols, rows):
        res = []
        for r in range(rows):
            t, b = cv[2 * r], cv[2 * r + 1]
            hi = cols - 1
            while hi >= 0 and t[hi] is None and b[hi] is None:
                hi -= 1
            out = []
            self.run(t, b, 0, hi, [None, None], out)
            res.append(("".join(out) + "\x1b[0m") if hi >= 0 else "")
        return res


# ------------------------------------------------------------------ scene
class Branch:
    __slots__ = ("path", "col", "t0", "dur", "done")

    def __init__(self, path, col, t0, dur):
        self.path, self.col, self.t0, self.dur, self.done = path, col, t0, dur, 0


class Petal:
    __slots__ = ("x", "y", "vy", "amp", "om", "ph", "age", "col", "col2")

    def __init__(self, x, y, vy, amp, om, ph, col):
        self.x, self.y, self.vy, self.amp, self.om, self.ph = x, y, vy, amp, om, ph
        self.age, self.col, self.col2 = 0.0, col, shade(col, .86)


class Scene:
    def __init__(self, cols, rows, o, seed=None):
        self.o, self.cols, self.rows = o, cols, rows
        self.W, self.H = cols, rows * 2
        self.seed = random.randrange(1, 10 ** 6) if seed is None else seed
        self.prng = random.Random(self.seed ^ 0x5EED)
        self.canvas = [[None] * self.W for _ in range(self.H)]
        self.t = 0.0
        if o.get("hex"):
            h = o["hex"]
            h = "".join(c * 2 for c in h) if len(h) == 3 else h
            self.pals = [ramp(tuple(int(h[i:i + 2], 16) for i in (0, 2, 4)))]
        elif o["color"] == "rainbow":
            self.pals = [THEMES[n] for n in RAINBOW]
        else:
            self.pals = [THEMES[o["color"]]]
        self.deep = self.pals[0][3]
        self.n_petals = o["petals"] if o["petals"] is not None else max(30, min(140, self.W // 2))
        self.fall = max(4.0, self.H * .1)
        self.petals, self.sparks, self.bloomed = [], [], []
        self.spawn_acc = self.spark_acc = 0.0
        self.next_b, self.running, self.next_p = 0, [], 0
        self.build_tree()

    # --- tree generation
    def gen(self, scale):
        rng = random.Random(self.seed)
        W, H = self.W, self.H
        cx, base_y = W / 2.0, float(H - 1)          # the trunk grows from the bottom edge
        tall = self.o["tall"]                       # -tall: long trunk, narrow crown
        hx = max(.3, min(.6, .62 * W / H)) if tall else 1.0   # squeezes sideways growth
        L0 = H * (.32 if tall else .2) * scale
        D = 5 + (H >= 56) + (H >= 90) + (H >= 130)
        rb = max(2.8, min(6.5, H * .05)) * min(1.4, max(.8, scale))
        br, cl, bb = [], [], [W, 0, H, 0]

        def addc(x, y, R, b, s):
            cl.append((x, y, R, b, s))
            bb[0], bb[1] = min(bb[0], x - R * 1.4), max(bb[1], x + R * 1.4)
            bb[2], bb[3] = min(bb[2], y - R * 1.4), max(bb[3], y + R * 1.4)

        def make(x, y, ang, length, th, depth, t0):
            n = max(2, int(length / .7))
            bend = rng.uniform(-.5, .5) * (.5 if depth == 0 else 1.0)
            th_end = max(1.0, th * .72)
            step, path, px, py = length / n, [], x, y
            for i in range(n + 1):
                s = i / n
                path.append((px, py, (th + (th_end - th) * s) / 2))
                a = ang + bend * s
                px += math.sin(a) * step * hx
                py -= math.cos(a) * step
            col = mix((70, 46, 40), (128, 92, 76), min(1.0, depth / max(1, D - 1)))
            b = Branch(path, mix(col, self.deep, .08), t0, length)
            br.append(b)
            for qx, qy, _ in path[::3]:
                bb[0], bb[1], bb[2] = min(bb[0], qx), max(bb[1], qx), min(bb[2], qy)
            ex, ey = path[-1][0], path[-1][1]
            if depth >= D - 1 or length < 3.2:
                addc(ex, ey, rb * rng.uniform(.9, 1.3), b, 1.0)
                if rng.random() < .55:
                    k = rng.randint(n // 2, n)
                    addc(path[k][0], path[k][1], rb * rng.uniform(.7, 1.0), b, k / n)
                return
            if depth >= 1 and rng.random() < .6:      # side twig
                k = int(n * rng.uniform(.45, .8))
                s = k / n
                a = ang + bend * s + rng.choice((-1, 1)) * rng.uniform(.5, 1.0)
                make(path[k][0], path[k][1], a, length * rng.uniform(.4, .6),
                     max(1.0, th * .55), depth + 1, t0 + length * (1 - math.sqrt(1 - s)))
            if depth == 0:
                kids = [rng.uniform(-.8, -.45), rng.uniform(.45, .8)]
                if rng.random() < .5:
                    kids.insert(1, rng.uniform(-.2, .2))
                lf = (.9, 1.0)
            else:
                sp = rng.uniform(.3, .65)
                kids = [-sp * rng.uniform(.6, 1.2), sp * rng.uniform(.6, 1.2)]
                if rng.random() < .12:
                    kids.append(rng.uniform(-.15, .15))
                lf = (.7, .84)
            if tall:                                  # longer branches
                lf = (lf[0] + .1, lf[1] + .08)
            if depth >= 2 and rng.random() < .35:
                k = int(n * .8)
                addc(path[k][0], path[k][1], rb * .8, b, k / n)
            for da in kids:
                make(ex, ey, ang + bend + da, length * rng.uniform(*lf),
                     max(1.0, th_end * rng.uniform(.9, 1.0)), depth + 1, t0 + length)

        make(cx, base_y + 1, rng.uniform(-.08, .08), L0, max(2.0, L0 * .3), 0, 0.0)
        return br, cl, bb, rng

    def build_tree(self):
        tall = self.o["tall"]
        scale = (2.4 if tall else 1.35) * self.o["scale"]   # start big, shrink until it fits
        for _ in range(140 if tall else 60):
            br, cl, bb, rng = self.gen(scale)
            if bb[0] >= self.W * .04 and bb[1] <= self.W * .96 and bb[2] >= self.H * .05:
                break
            scale *= .97 if tall else .95
        g = self.o["grow"]
        k = .68 * g / max(b.t0 + b.dur for b in br)     # bare branches first, blossoms follow
        for b in br:
            b.t0 *= k
            b.dur *= k
        br.sort(key=lambda b: b.t0)
        self.branches = br
        pix = []
        for x, y, R, b, s in cl:
            pal = rng.choice(self.pals)
            tc = b.t0 + b.dur * (1.0 if s >= 1 else 1 - math.sqrt(1 - s))
            tc = .36 * g + tc / (.68 * g) * .5 * g + rng.uniform(0, .6)
            blobs = [(0.0, 0.0, R)] + [(rng.uniform(-.6, .6) * R, rng.uniform(-.6, .6) * R,
                                         R * rng.uniform(.4, .65)) for _ in range(4)]
            for bx, by, r in blobs:
                for _ in range(int(r * r * 2.6) + 2):
                    a, d = rng.uniform(0, 6.2832), r * math.sqrt(rng.random())
                    dx, dy = bx + math.cos(a) * d, by + math.sin(a) * d * .85
                    if rng.random() < .15:
                        continue
                    sh = (dx * .45 + dy * .75) / R + rng.gauss(0, .35)
                    ci = min(4, max(0, int((sh + 1.3) / 2.6 * 5)))
                    pix.append((tc + rng.uniform(0, 1.4), int(x + dx), int(y + dy), pal[ci]))
        pix.sort(key=lambda p: p[0])
        self.pixels = pix
        self.done_t = max(self.o["grow"], pix[-1][0] if pix else 0) + .5

    # --- simulation
    def stamp(self, x, y, r, c):
        W, H, cv = self.W, self.H, self.canvas
        xi, yi = int(round(x)), int(round(y))
        if r < .8:
            if 0 <= xi < W and 0 <= yi < H:
                cv[yi][xi] = c
            return
        ri = int(math.ceil(r))
        for dy in range(-ri, ri + 1):
            yy = yi + dy
            if 0 <= yy < H:
                row = cv[yy]
                for dx in range(-ri, ri + 1):
                    if dx * dx + dy * dy <= r * r + .3 and 0 <= xi + dx < W:
                        tl = (dx * .8 + dy * .6) / (r + .5)
                        row[xi + dx] = shade(c, 1.15 - .3 * (.5 + .5 * tl))

    def wind(self):
        t = self.t
        return self.o["wind"] * (3.2 + 2.8 * math.sin(.31 * t) + 1.6 * math.sin(.83 * t + 1.3))

    def step(self, dt):
        self.t += dt
        t, W, H = self.t, self.W, self.H
        while self.next_b < len(self.branches) and self.branches[self.next_b].t0 <= t:
            self.running.append(self.branches[self.next_b])
            self.next_b += 1
        still = []
        for b in self.running:
            u = (t - b.t0) / b.dur
            idx = len(b.path) if u >= 1 else int((1 - (1 - u) ** 2) * len(b.path))
            for x, y, r in b.path[b.done:idx]:
                self.stamp(x, y, r, b.col)
            b.done = idx
            if idx < len(b.path):
                still.append(b)
        self.running = still
        px = self.pixels
        while self.next_p < len(px) and px[self.next_p][0] <= t:
            _, x, y, c = px[self.next_p]
            if 0 <= x < W and 0 <= y < H:
                self.canvas[y][x] = c
                if self.next_p % 3 == 0:
                    self.bloomed.append((x, y))
            self.next_p += 1
        self.update_petals(dt)

    def update_petals(self, dt):
        W, r = self.W, self.prng
        frac = self.next_p / max(1, len(self.pixels))
        target = int(self.n_petals * min(1.0, max(0.0, (frac - .35) / .5)))
        if self.bloomed and len(self.petals) < target:
            self.spawn_acc += dt * self.n_petals / 6.0
            while self.spawn_acc >= 1 and len(self.petals) < target:
                x, y = r.choice(self.bloomed)
                pal = r.choice(self.pals)
                self.petals.append(Petal(x + r.uniform(-1, 1), y + r.uniform(0, 2),
                                         self.fall * r.uniform(.7, 1.3), r.uniform(1, 2.6),
                                         r.uniform(1.4, 3.2), r.uniform(0, 6.28),
                                         pal[r.choice((0, 0, 1, 1, 2, 3))]))
                self.spawn_acc -= 1
            self.spawn_acc = min(self.spawn_acc, 1.0)
        if self.bloomed:                                     # little glints in the canopy
            self.spark_acc += dt * 5
            while self.spark_acc >= 1:
                x, y = r.choice(self.bloomed)
                self.sparks.append([x, y, 0.0])
                self.spark_acc -= 1
        for s in self.sparks:
            s[2] += dt
        self.sparks = [s for s in self.sparks if s[2] < .6]
        wind, alive = self.wind(), []
        for p in self.petals:
            p.age += dt
            p.x += (wind + p.amp * p.om * math.cos(p.om * p.age + p.ph)) * dt
            p.y += p.vy * dt * (1 + .3 * math.sin(p.om * 1.7 * p.age + p.ph))
            if not 0 <= p.x < W or p.y >= self.H:     # blown away or fallen off the bottom
                continue
            alive.append(p)
        self.petals = alive

    def fast_forward(self, T):
        while self.t < T:
            self.step(min(1 / 30, T - self.t))

    def frame(self):
        W, H = self.W, self.H
        cv = [row[:] for row in self.canvas]
        for p in self.petals:
            x, y = int(p.x), int(p.y)
            if 0 <= x < W and 0 <= y < H:
                cv[y][x] = p.col
                if x + 1 < W and math.sin(p.age * p.om * 2 + p.ph) > .5:
                    cv[y][x + 1] = p.col2
        for x, y, age in self.sparks:
            c = cv[y][x]
            if c:
                cv[y][x] = mix(c, (255, 255, 255), .75 * math.sin(math.pi * age / .6))
        return cv


# -------------------------------------------------------------------- cli
VAL = {"seed": int, "speed": float, "grow": float, "petals": int, "wind": float, "scale": float,
       "fps": int, "cycle": float, "time": float, "width": int, "height": int, "hex": str, "color": str}
SHORT = {"s": "seed", "t": "time", "c": "color", "p": "print", "i": "instant",
         "l": "list", "h": "help", "v": "version"}
FLAGS = {"print", "instant", "truecolor", "256", "list", "help", "version"}


def die(msg):
    sys.stderr.write("xsakura: %s\ntry 'xsakura --help'\n" % msg)
    sys.exit(2)


def parse(argv):
    o = dict(color="sakura", seed=None, speed=1.0, grow=9.0, petals=None, wind=1.0, scale=1.0,
             fps=30, cycle=0.0, time=0.0, width=0, height=0, hex=None, **{
                 "print": False, "instant": False, "tall": True,
                 "truecolor": False, "256": False, "list": False, "help": False, "version": False})
    i = 0
    while i < len(argv):
        a = argv[i]
        i += 1
        if not a.startswith("-") or a == "-":
            die("unexpected argument: %s" % a)
        name, eq, val = a.lstrip("-").partition("=")
        name = SHORT.get(name.lower(), name.lower())
        if name in THEMES or name == "rainbow":
            o["color"] = name
        elif name == "mini":                       # the shorter, wider tree
            o["tall"] = False
        elif name == "tall":                       # the default, kept so old commands still work
            o["tall"] = True
        elif name in FLAGS:
            o[name.replace("-", "_")] = True
        elif name in VAL:
            if not eq:
                if i >= len(argv):
                    die("option %s needs a value" % a)
                val = argv[i]
                i += 1
            try:
                o[name] = VAL[name](val.lstrip("#") if name == "hex" else val)
            except ValueError:
                die("bad value for %s: %s" % (a, val))
        else:
            die("unknown option: %s" % a)
    if o["color"] not in THEMES and o["color"] != "rainbow":
        die("unknown color: %s (see --list)" % o["color"])
    h = o["hex"]
    if h is not None and (len(h) not in (3, 6) or any(c not in "0123456789abcdefABCDEF" for c in h)):
        die("--hex wants a color like ff66aa")
    o["fps"] = max(1, min(120, o["fps"]))
    o["grow"] = max(.5, o["grow"])
    o["speed"] = max(.05, o["speed"])
    return o


def size(o, printing=False):
    c, r = shutil.get_terminal_size((80, 24))
    c = o["width"] or c
    r = o["height"] or (max(8, r - 1) if printing else r)
    return max(20, c), max(8, r)


def truecolor(o):
    if o["truecolor"] or o["256"]:
        return o["truecolor"]
    env = os.environ
    return env.get("COLORTERM", "") in ("truecolor", "24bit") or any(
        k in env.get("TERM", "") for k in ("direct", "kitty", "alacritty", "foot", "wezterm"))


def do_print(o):
    cols, rows = size(o, True)
    sc = Scene(cols, rows, o, o["seed"])
    sc.fast_forward(sc.done_t + 6.0)
    lines = Term(truecolor(o)).lines(sc.frame(), cols, rows)
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    sys.stdout.write("\n".join(lines) + "\n")


def do_list(o):
    tc = Term(truecolor(o))
    for n in list(THEMES) + ["rainbow"]:
        c = THEMES[n][2] if n in THEMES else THEMES["pink"][2]
        sys.stdout.write("\x1b[%sm██\x1b[0m -%s\n" % (tc.col(38, c), n))


def live(o):
    import termios, tty
    out = sys.stdout
    tin = sys.stdin.isatty()
    fd = sys.stdin.fileno() if tin else None
    old = termios.tcgetattr(fd) if tin else None
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))

    def w(s):
        out.write(s)
        out.flush()

    term, fdt = Term(truecolor(o)), 1.0 / o["fps"]
    w("\x1b[?1049h\x1b[?25l\x1b[2J")
    try:
        if tin:
            tty.setcbreak(fd)
        cols, rows = size(o)
        sc = Scene(cols, rows, o, o["seed"])
        if o["instant"]:
            sc.fast_forward(sc.done_t)
        prev, paused = None, False
        start = last = time.monotonic()
        while True:
            now = time.monotonic()
            dt, last = min(now - last, .1), now
            if (cols, rows) != size(o):
                cols, rows = size(o)
                t_old = sc.t
                sc = Scene(cols, rows, o, sc.seed)
                sc.fast_forward(t_old)
                prev = None
                w("\x1b[2J")
            if not paused:
                sc.step(dt * o["speed"])
            cv = sc.frame()
            w("\x1b[?2026h" + term.render(cv, prev, cols, rows) + "\x1b[?2026l")
            prev = cv
            regrow = o["cycle"] and sc.t > sc.done_t + o["cycle"]
            if o["time"] and now - start >= o["time"]:
                break
            left = fdt - (time.monotonic() - now)
            if tin:
                if select.select([fd], [], [], max(0.0, left))[0]:
                    data = os.read(fd, 64)
                    if data == b"\x1b" or data[:1] in (b"q", b"Q", b"\x03"):
                        break
                    if data[:1] == b" ":
                        paused = not paused
                    elif data[:1] in (b"r", b"R"):
                        regrow = True
            else:
                time.sleep(max(0.0, left))
            if regrow:
                sc = Scene(cols, rows, o, None)
                prev = None
                w("\x1b[2J")
    except KeyboardInterrupt:
        pass
    finally:
        if tin:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        w("\x1b[0m\x1b[?25h\x1b[?1049l")


def main():
    o = parse(sys.argv[1:])
    if o["help"]:
        sys.stdout.write(HELP)
    elif o["version"]:
        print("xsakura " + __version__)
    elif o["list"]:
        do_list(o)
    elif o["print"] or not sys.stdout.isatty():
        do_print(o)
    else:
        live(o)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
